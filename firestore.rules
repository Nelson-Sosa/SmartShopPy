rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the user is an admin
    function isAdmin() {
      return request.auth != null
        && request.auth.uid != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Users collection: admin can write, owner can read their own, admin can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;

      // Wishlist subcollection: only the owner can read/write their own wishlist
      match /wishlist/{itemId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Categories collection
    match /categories/{categoryId} {
      // Any user can read categories
      allow read: if true;
      // Only admin can create, update, delete
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Orders collection (POS sales + sales generated from delivered pedidos)
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Pedidos collection (orders with multi-state lifecycle and stock reservation)
    match /pedidos/{pedidoId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Settings collection (for public business info like WhatsApp)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Counters collection (for tracking codes, invoices, etc)
    match /counters/{document} {
      // Anyone can read and update counters to generate IDs
      allow read, write: if true;
    }

    // Technical Services collection
    match /technical_services/{serviceId} {
      // Anyone can create (clients without account)
      allow create: if true;
      // Anyone can read by their trackingCode (public query)
      allow read: if true;
      // Admin can update everything
      // Client can only change quoteStatus if it's pending
      allow update: if isAdmin() || (
        resource.data.quoteStatus == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["quoteStatus", "quoteApprovedAt", "quoteRejectedAt", "updatedAt", "status", "history"])
      );
      allow delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
